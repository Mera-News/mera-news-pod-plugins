{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mera-news",
  "version": "0.4.7",
  "description": "News picked for what you follow, from thousands of publishers in many languages. Mera Labs keeps no copy of your interests. Needs a key from Mera Labs.",
  "author": {
    "name": "Mera Labs B.V.",
    "url": "https://mera.news"
  },
  "homepage": "https://mera.news/self-host",
  "repository": "https://github.com/Mera-News/mera-news-pod-plugins",
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "news",
    "headlines",
    "current events",
    "mera news"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Mera News",
        "shortDescription": "News picked for what you follow. Mera Labs keeps no copy of your interests.",
        "developerName": "Mera Labs B.V.",
        "category": "Productivity",
        "websiteURL": "https://mera.news/self-host",
        "privacyPolicyURL": "https://mera.news/privacy",
        "termsOfServiceURL": "https://mera.news/terms",
        "logo": "./assets/icon.png"
      }
    }
  }
}
