{
  "name": "mera-news",
  "displayName": "Mera News",
  "version": "0.4.0",
  "description": "News picked for what you follow, from thousands of publishers in many languages. Mera Labs keeps no copy of your interests. Needs a key from Mera Labs.",
  "author": {
    "name": "Mera Labs B.V.",
    "url": "https://mera.news"
  },
  "homepage": "https://mera.news/self-host",
  "repository": "https://github.com/Mera-News/mera-news-pod-plugins",
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "news",
    "headlines",
    "current events",
    "mera news"
  ],
  "icon": "assets/icon.png",
  "documentationUrl": "https://github.com/Mera-News/mera-news-pod/blob/main/docs/clients.md",
  "supportUrl": "https://github.com/Mera-News/mera-news-pod-plugins/issues",
  "privacyPolicyUrl": "https://mera.news/privacy",
  "termsOfServiceUrl": "https://mera.news/terms",
  "engines": {
    "node": ">=22.13"
  },
  "network": {
    "hosts": [
      "api.mera.news"
    ]
  },
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Mera News key",
      "description": "Ask Mera Labs for a key: message Mera on WhatsApp or write to contact@mera.news.",
      "sensitive": true,
      "required": true
    },
    "web": {
      "type": "boolean",
      "title": "Also run the Mera News website on this computer",
      "description": "Shows your news, top stories and profile in your browser. Only this computer can open it.",
      "default": true,
      "required": false
    }
  },
  "mcpServers": {
    "mera-news": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/server.cjs"
      ],
      "env": {
        "MERA_POD_DATA_API_KEY": "${user_config.api_key}",
        "MERA_POD_WEB": "${user_config.web}"
      }
    }
  }
}
